FROM python:3.10-slim

WORKDIR /app
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY backend ./
COPY frontend /frontend
ENV PYTHONPATH=/app COMMERCE_FRONTEND_DIR=/frontend
EXPOSE 8000
CMD ["uvicorn", "commerce_agent.api:app", "--host", "0.0.0.0", "--port", "8000"]
