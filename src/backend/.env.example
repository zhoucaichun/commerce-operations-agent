# 模型统一模板：复制为同目录 .env，只填写本地副本，勿覆盖已有配置。
# 选型与用法：docs/runtime/模型选型与统一配置.md。密钥不要发聊天/截图/前端。
# 一、聊天模型：规划与回答当前共用一个模型。
COMMERCE_LLM_PROVIDER=openai_compatible
COMMERCE_LLM_BASE_URL=
COMMERCE_LLM_API_KEY=
COMMERCE_LLM_MODEL=Qwen3.6-35B-A3B
# 以上只是暂定候选；使用平台复制的完整 ID，不代表已验证最优。
# 默认自动追加聊天路径；只有平台明确提供自定义路径时才填写。
COMMERCE_LLM_CHAT_PATH=
# 先试 json_object；平台及当前 Schema 均确认兼容后才切 json_schema。
COMMERCE_LLM_RESPONSE_MODE=json_object
COMMERCE_LLM_TIMEOUT_SECONDS=30

# 二、RAG 专用向量模型。当前阿里云候选为 text-embedding-v4；独立填写其地址和密钥。
# 空值是离线哈希模式，不是语义检索。
COMMERCE_EMBEDDING_MODEL=
# 留空复用聊天服务地址/密钥；不同服务才填这两项。
COMMERCE_EMBEDDING_BASE_URL=
COMMERCE_EMBEDDING_API_KEY=
COMMERCE_EMBEDDING_TIMEOUT_SECONDS=15
COMMERCE_EMBEDDING_BATCH_SIZE=8
# 空值不落盘；需要持久缓存时填本仓库 reports 下路径。
COMMERCE_EMBEDDING_CACHE=

# 三、未接入角色：以下仅选型备忘，不是已生效的配置。
# 评测裁判候选：DeepSeek-V4-Flash-0731-W8A8，需要独立 Judge Adapter 和人工校准。
# 图片理解候选：Qwen3-VL-30B-A3B-Instruct，当前仍是合成附件元数据。
# Reranker 暂不配置，先完成混合召回实验。ASR/TTS 当前也无需配置。
# doubao-seed-2.0-code-previ... 的截图 ID 被截断，不可直接使用。

# 四、生产开关。配置模型不授予真实商家读写权限。
COMMERCE_PRODUCTION_MODE=false
COMMERCE_SHOPIFY_CONNECTOR_ENABLED=false
COMMERCE_OIDC_ISSUER=
COMMERCE_OIDC_AUDIENCE=
