# Optional model-assisted planning/composition. Leave all three empty for deterministic MVP mode.
# qwen_openai_compatible is the recommended development label when using an
# approved Qwen/DashScope OpenAI-compatible endpoint.  The URL/model ID must
# come from your approved provider workspace; never commit either a real key or a gateway URL carrying credentials.
COMMERCE_LLM_PROVIDER=qwen_openai_compatible
COMMERCE_LLM_BASE_URL=
COMMERCE_LLM_API_KEY=
COMMERCE_LLM_MODEL=
# Leave empty for the normal OpenAI-compatible convention. The adapter uses
# /v1/chat/completions for a service root, or /chat/completions when BASE_URL
# already ends in /v1. Set this only for a provider-documented custom route.
COMMERCE_LLM_CHAT_PATH=
# Use json_schema only after the selected endpoint has verified support; unsupported
# providers safely fall back to deterministic routing after the request fails.
COMMERCE_LLM_RESPONSE_MODE=json_object
COMMERCE_LLM_TIMEOUT_SECONDS=8

# Production gates only; setting these never enables commerce write operations.
COMMERCE_PRODUCTION_MODE=false
COMMERCE_SHOPIFY_CONNECTOR_ENABLED=false
COMMERCE_OIDC_ISSUER=
COMMERCE_OIDC_AUDIENCE=
